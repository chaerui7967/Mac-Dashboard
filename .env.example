# 이 파일을 .env로 복사해서 실제 경로를 채워 넣으세요.
# .env는 .gitignore에 포함되어 커밋되지 않습니다.

# Git 저장소 목록: "name:path" 쌍을 콤마(,)로 구분
GIT_REPOS=myproject:/Users/username/projects/myproject,another:/Users/username/projects/another

# Git activity 로그 파일 경로 (선택, 기본값: ~/macmini-dashboard-git.log)
GIT_ACTIVITY_LOG=~/macmini-dashboard-git.log
